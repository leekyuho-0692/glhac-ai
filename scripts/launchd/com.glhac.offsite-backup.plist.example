<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.glhac.offsite-backup</string>
    <!--
      설치: build_launcher.sh가 백업 스크립트를 내장한 런처를 빌드·서명한다.
      사용자 소유의 INSTALL_DIR(0700)에 런처(0700)와 .sha256 기록(0600)을 설치한다.
      실행할 외부 .sh 파일은 설치하지 않는다.
      시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한에서
      glhac-offsite-backup 파일만 추가한 뒤 작업을 등록하고 kickstart로 점검한다.
      /bin/bash에 권한을 주지 않는다. 스크립트 수정 시 재빌드·재설치·FDA 재등록한다.
      INSTALL_DIR, HOST, KEY_PATH, LOCAL_DIR, MIRROR_DIR를 실제 절대경로/값으로 바꾼다.
      미러를 쓰지 않으면 MIRROR_DIR 값은 빈 문자열로 둔다. 자세한 절차: docs/offsite-backup.md
    -->
    <key>ProgramArguments</key>
    <array>
        <string>&lt;INSTALL_DIR&gt;/glhac-offsite-backup</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TZ</key><string>Asia/Seoul</string>
        <key>GLHAC_BACKUP_HOST</key><string>&lt;HOST&gt;</string>
        <key>GLHAC_BACKUP_USER</key><string>rocky</string>
        <key>GLHAC_BACKUP_KEY</key><string>&lt;KEY_PATH&gt;</string>
        <key>GLHAC_BACKUP_REMOTE_DIR</key><string>/var/backups/glhac</string>
        <key>GLHAC_BACKUP_LOCAL_DIR</key><string>&lt;LOCAL_DIR&gt;</string>
        <key>GLHAC_BACKUP_MIRROR_DIR</key><string>&lt;MIRROR_DIR&gt;</string>
        <key>GLHAC_BACKUP_MAX_AGE_HOURS</key><string>36</string>
        <key>GLHAC_BACKUP_NOTIFY</key><string>1</string>
    </dict>
    <key>StandardOutPath</key><string>&lt;LOCAL_DIR&gt;/offsite-backup.stdout.log</string>
    <key>StandardErrorPath</key><string>&lt;LOCAL_DIR&gt;/offsite-backup.stderr.log</string>
    <key>ProcessType</key><string>Background</string>
</dict>
</plist>
