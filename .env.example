# GL-HAC AI v3 — 환경변수 예시. 실제 값은 .env(커밋 금지)에 넣으세요.

# ── 보안(필수) ─────────────────────────────────────────────
# 토큰 서명 시크릿. 프로덕션에서 미설정이면 부팅 실패(기본값 위조 방지).
# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
GLHAC_SECRET=change-me-to-a-strong-random-value

# 개발 모드: 데모 8계정 시드 + 기본 시크릿 허용. 프로덕션에서는 절대 1로 두지 말 것.
GLHAC_DEV=0

# 프로덕션 최초 admin 부트스트랩(사용자 0명일 때만 생성). GLHAC_DEV=0에서 사용.
GLHAC_ADMIN_USER=
GLHAC_ADMIN_PASSWORD=

# ── DB ────────────────────────────────────────────────────
# 기본은 SQLite 파일. Postgres 전환: postgresql+psycopg2://user:pw@host:5432/glhac
GLHAC_DB_URL=sqlite:///./glhac.db

# ── CORS(분리형 SPA 사용 시에만) ───────────────────────────
# 콤마 구분 허용 출처. 비우면 동일 출처만.
GLHAC_CORS_ORIGINS=

# ── 파일/OCR ───────────────────────────────────────────────
# 경로 기반 OCR 입력 샌드박스(이 접두 밖 경로는 거부).
GLHAC_UPLOAD_DIR=/tmp/glhac_uploads

# ── 알림 워커 ──────────────────────────────────────────────
# 1이면 인프로세스 데몬이 주기적으로 큐 드레인. 멀티워커 배포 시엔 0으로 두고 외부 cron이 /admin/notify-drain 호출 권장.
GLHAC_NOTIFY_WORKER=0

# ── 알림 채널 크리덴셜(선택) ───────────────────────────────
# Twilio SMS/WhatsApp
GLHAC_TWILIO_SID=
GLHAC_TWILIO_TOKEN=
GLHAC_TWILIO_SMS_FROM=
GLHAC_TWILIO_WA_FROM=
# KakaoTalk 알림톡(대행사 연동 — 현재 미구현 스텁)
GLHAC_KAKAO_API_KEY=
# Email(SMTP) — 설정 시 email 채널 활성화
GLHAC_SMTP_HOST=
GLHAC_SMTP_PORT=587
GLHAC_SMTP_USER=
GLHAC_SMTP_PASS=
GLHAC_SMTP_FROM=
# Webhook — 케이스 알림을 외부 시스템으로 POST(HMAC 서명). URL 설정 시 webhook 채널 활성화.
GLHAC_WEBHOOK_URL=
GLHAC_WEBHOOK_SECRET=

# ── 로깅 ──────────────────────────────────────────────────
GLHAC_LOG_LEVEL=INFO
