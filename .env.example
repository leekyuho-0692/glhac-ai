# GL-HAC AI v3 — 환경변수 예시. 실제 값은 .env(커밋 금지)에 넣으세요.

# ── 보안(필수) ─────────────────────────────────────────────
# 토큰 서명 시크릿. 프로덕션에서 미설정이면 부팅 실패(기본값 위조 방지).
# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
GLHAC_SECRET=change-me-to-a-strong-random-value

# 개발 모드: 데모 8계정 시드 + 기본 시크릿 허용. 프로덕션에서는 절대 1로 두지 말 것.
GLHAC_DEV=0

# 프로덕션 최초 admin 부트스트랩(사용자 0명일 때만 생성). GLHAC_DEV=0에서 사용.
GLHAC_ADMIN_USER=
GLHAC_ADMIN_PASSWORD=

# PII 암호화(선택, 점진 적용). 1로 켜기 전 GLHAC_ENC_KEY 설정 권장.
GLHAC_ENCRYPTION=0
GLHAC_ENC_KEY=
GLHAC_ENC_KEY_VERSION=1

# ── DB ────────────────────────────────────────────────────
# 기본은 SQLite 파일. Postgres 전환: postgresql+psycopg2://user:pw@host:5432/glhac
GLHAC_DB_URL=sqlite:///./glhac.db

# ── CORS(분리형 SPA 사용 시에만) ───────────────────────────
# 콤마 구분 허용 출처. 비우면 동일 출처만.
GLHAC_CORS_ORIGINS=

# ── 파일/OCR ───────────────────────────────────────────────
# 경로 기반 OCR 입력 샌드박스(이 접두 밖 경로는 거부).
GLHAC_UPLOAD_DIR=/tmp/glhac_uploads
# OCR 워커/inproc 공통: 프로세스당 언어별 엔진 LRU 상한(기본 2, 최소 1).
# 메모리가 작은 환경은 1로 제한. 유휴 워커 종료 시 캐시도 함께 해제된다.
# 프로브 사용 시 언어 엔진 LRU와 별도로 인식 모델 1개(eslav mobile rec)가 추가 상주.
GLHAC_OCR_ENGINE_CACHE_SIZE=2
# 빈 값은 기존 기본값 유지; 느린 CPU 서버 권장 PP-OCRv5_mobile_det (4코어 Xeon Silver 4510, 스캔 PDF 6페이지·200dpi 실측: 서버→모바일 229→96초, 텍스트 유사도 0.963~0.996, 글자 수 차 0~5자).
# 언어별 기본 인식 모델도 함께 유지한다. 인식 모델을 결정할 수 없으면 경고 후 검출 모델 지정 생략.
GLHAC_OCR_DET_MODEL=
# 한글 없는 쪽의 원래 줄 polygon을 전체 OCR과 같은 PaddleX crop으로 샘플링(기본 1).
# 키릴 2줄 또는 10자 이상이면 ru 전체 OCR. 일부 빈 판독/미지원/polygon 없음도 전체 OCR.
# 0이면 종전처럼 비한글 쪽을 항상 ru 전체 OCR. ru 외 폴백 언어에는 적용하지 않음.
GLHAC_OCR_CYRILLIC_PROBE=1
# 쪽당 샘플 줄 상한(기본 12, 1~12로 클램프). 줄 중심의 세로 구간 × 가로 3열 라운드로빈.
GLHAC_OCR_CYRILLIC_PROBE_LINES=12

# ── 알림 워커 ──────────────────────────────────────────────
# 1이면 인프로세스 데몬이 주기적으로 큐 드레인. 멀티워커 배포 시엔 0으로 두고
# 외부 cron이 /admin/notify-drain 호출 권장.
GLHAC_NOTIFY_WORKER=0

# ══════════════════════════════════════════════════════════
#  외부연동 크리덴셜 (선택) — 미설정 시 해당 채널은 no_credentials 스텁(로그만).
#  설정 상태는 관리자 GET /admin/notify-channels 로 값 노출 없이 확인 가능.
#  자세한 발급/연동법: docs/GLHAC_외부연동_크리덴셜_가이드.md
# ══════════════════════════════════════════════════════════

# ── SMS / WhatsApp (Twilio) ────────────────────────────────
GLHAC_TWILIO_SID=
GLHAC_TWILIO_TOKEN=
GLHAC_TWILIO_SMS_FROM=          # 예: +14155550123
GLHAC_TWILIO_WA_FROM=           # 예: +14155550123 (whatsapp: 접두는 코드가 부착)

# ── KakaoTalk 알림톡 (비즈메시지 대행사: Solapi·Aligo·NHN 등) ─
# URL+KEY 둘 다 설정해야 실발송. SENDER_KEY/TEMPLATE_CODE는 대행사 승인 템플릿용.
GLHAC_KAKAO_API_URL=            # 대행사 발송 엔드포인트
GLHAC_KAKAO_API_KEY=
GLHAC_KAKAO_SENDER_KEY=         # 발신프로필 키(선택)
GLHAC_KAKAO_TEMPLATE_CODE=      # 승인 템플릿 코드(선택)

# ── Email (SMTP) ───────────────────────────────────────────
GLHAC_SMTP_HOST=
# Trusted public application origin for password recovery links
GLHAC_APP_URL=https://glhac.co.kr
GLHAC_SMTP_PORT=587
GLHAC_SMTP_USER=
GLHAC_SMTP_PASS=
GLHAC_SMTP_FROM=                # 미설정 시 SMTP_USER 사용

# ── Webhook (외부 시스템 이벤트 수신용) ────────────────────
GLHAC_WEBHOOK_URL=              # 전역 webhook 수신 URL(케이스별 등록도 가능)
GLHAC_WEBHOOK_SECRET=           # HMAC-SHA256 서명 시크릿

# ── 결제 PG (Midtrans / Xendit) — 콜백 서명검증용 ──────────
# 콜백 수신: POST /webhooks/payment/{provider}. provider별 서명키.
GLHAC_PG_WEBHOOK_SECRET=        # 공용 콜백 서명 시크릿(fallback)
# provider별: GLHAC_PG_SECRET_MIDTRANS / GLHAC_PG_SECRET_XENDIT
GLHAC_PG_SECRET_MIDTRANS=
GLHAC_PG_SECRET_XENDIT=

# ── 로깅 ──────────────────────────────────────────────────
GLHAC_LOG_LEVEL=INFO
